<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="line_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- REQUIRED in every world -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Flat, shadow-free lighting keeps the line contrast stable -->
    <scene>
      <ambient>0.9 0.9 0.9 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Demo line. Replace with your own random lines.
         Rule: visual-only, thin, at z = 0.001 (no collision). -->
    <model name="demo_line">
      <static>true</static>
      <link name="link">
        <visual name="seg_a">
          <pose>0.5 0 0.001 0 0 0</pose>
          <geometry><box><size>2.0 0.03 0.002</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
        <visual name="seg_b">
          <pose>2.1495 0.375 0.001 0 0 0.5236</pose>
          <geometry><box><size>1.5 0.03 0.002</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
        <visual name="seg_c">
          <pose>3.4485 0.375 0.001 0 0 -0.5236</pose>
          <geometry><box><size>1.5 0.03 0.002</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>