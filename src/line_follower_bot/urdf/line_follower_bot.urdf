<?xml version="1.0"?>
<!--
  Line follower bot, resized to fit a 150 x 150 x 40 mm envelope
  (length x width x height, measured from the ground, wheels and camera included).

  base_link origin = wheel axle, 0.018 m above ground.
  So in the base_link frame: ground is z = -0.018, the 40 mm ceiling is z = +0.022.
-->
<robot name="line_follower_bot">

  <material name="body_blue"><color rgba="0.1 0.3 0.8 1.0"/></material>
  <material name="wheel_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="cam_red"><color rgba="0.8 0.1 0.1 1.0"/></material>

  <!-- Chassis: 130 x 120 x 16 mm, centred on the axle, 10 mm ground clearance -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.30"/>
      <inertia ixx="3.664e-4" ixy="0" ixz="0" iyy="4.289e-4" iyz="0" izz="7.825e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.13 0.12 0.016"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.13 0.12 0.016"/></geometry>
    </collision>
  </link>

  <!-- Drive wheels: radius 18 mm (36 mm diameter), width 10 mm, centres at y = +/-70 mm
       so the outer faces sit exactly at y = +/-75 mm (150 mm overall width) -->
  <link name="left_wheel_link">
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="2.68e-6" ixy="0" ixz="0" iyy="2.68e-6" iyz="0" izz="4.86e-6"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.018" length="0.01"/></geometry>
      <material name="wheel_grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.018" length="0.01"/></geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.07 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_wheel_link">
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="2.68e-6" ixy="0" ixz="0" iyy="2.68e-6" iyz="0" izz="4.86e-6"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.018" length="0.01"/></geometry>
      <material name="wheel_grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.018" length="0.01"/></geometry>
    </collision>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.07 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Frictionless casters: radius 9 mm, bottoms level with the wheels (z = -0.018) -->
  <link name="caster_front_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="3.24e-7" ixy="0" ixz="0" iyy="3.24e-7" iyz="0" izz="3.24e-7"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.009"/></geometry>
      <material name="wheel_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.009"/></geometry>
    </collision>
  </link>
  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front_link"/>
    <origin xyz="0.055 0 -0.009" rpy="0 0 0"/>
  </joint>

  <link name="caster_rear_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="3.24e-7" ixy="0" ixz="0" iyy="3.24e-7" iyz="0" izz="3.24e-7"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.009"/></geometry>
      <material name="wheel_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.009"/></geometry>
    </collision>
  </link>
  <joint name="caster_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_rear_link"/>
    <origin xyz="-0.055 0 -0.009" rpy="0 0 0"/>
  </joint>

  <!-- Camera: just ahead of the chassis front edge, pitched 0.75 rad (~43 deg) down.
       Body is 12 x 30 x 10 mm and sits behind the optical origin. -->
  <link name="camera_link">
    <inertial>
      <origin xyz="-0.006 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="4.17e-7" ixy="0" ixz="0" iyy="1.02e-7" iyz="0" izz="4.35e-7"/>
    </inertial>
    <visual>
      <origin xyz="-0.006 0 0" rpy="0 0 0"/>
      <geometry><box size="0.012 0.03 0.01"/></geometry>
      <material name="cam_red"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.07 0 0.008" rpy="0 0.55 0"/>
  </joint>

  <!-- ================= Gazebo (Harmonic) ================= -->
  <gazebo reference="left_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="caster_front_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="caster_rear_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

  <gazebo reference="camera_link">
    <sensor name="line_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <topic>camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.3</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>5.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.14</wheel_separation>
      <wheel_radius>0.018</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>4.0</max_angular_velocity>
      <min_angular_velocity>-4.0</min_angular_velocity>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
